# Copia este archivo como .env y ajusta los valores. NUNCA subas .env al repositorio.

NODE_ENV=development
PORT=3000

# Base de datos (con docker compose: pnpm db:up)
DATABASE_URL=postgres://transporte:transporte@localhost:5432/transporte

# Secreto para firmar tokens. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# Orígenes permitidos (PWA), separados por coma
CORS_ORIGINS=http://localhost:3001
# URL pública de la PWA (para los enlaces de los correos)
WEB_APP_URL=http://localhost:3001

# Correo: "console" (desarrollo, imprime en consola) o "resend" (producción)
MAIL_PROVIDER=console
MAIL_FROM=Transporte <no-responder@tudominio.com>
RESEND_API_KEY=

THROTTLE_ENABLED=true
